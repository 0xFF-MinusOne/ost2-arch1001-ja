{
"i": 374,
"where": "スライド16",
"en": "Quiz: How can you tell if a register's being used as a callee-save reg?",
"ja": ""
},
{
"i": 376,
"where": "スライド16",
"en": "A: it's saved at the beginning of a function and restored at the end",
"ja": ""
},
{
"i": 378,
"where": "スライド16",
"en": "Quiz: How can you tell if a register's being used as a caller-save reg?",
"ja": ""
},
{
"i": 379,
"where": "スライド16",
"en": "A: It's being saved before a call, and restored after",
"ja": ""
},
{
"i": 380,
"where": "スライド17",
"en": "Function parameters tend to get referenced as \"ebp+offset\"",
"ja": ""
},
{
"i": 381,
"where": "スライド17",
"en": "Local variables tend to get referenced as \"ebp-offset\"",
"ja": ""
},
{
"i": 382,
"where": "スライド17",
"en": "Although gcc sometimes references as esp+offset",
"ja": ""
},
