"i": 11,
"where": "スライド3",
"en": "In 32 bit code, there are many more calling conventions in use",
"ja": ""
},
{
"i": 12,
"where": "スライド3",
"en": "“cdecl” (default for most C code)",
"ja": ""
},
{
"i": 13,
"where": "スライド3",
"en": "Caller cleans up the stack",
"ja": ""
},
{
"i": 14,
"where": "スライド3",
"en": "“stdcall” (for Windows' Win32 APIs)",
"ja": ""
},
{
"i": 15,
"where": "スライド3",
"en": "Callee cleans up the stack",
"ja": ""
},
{
"i": 16,
"where": "スライド3",
"en": "Function parameters are pushed onto stack from right to left",
"ja": ""
},
{
"i": 17,
"where": "スライド3",
"en": "leftmost parameter (the first function parameter) ends up at the lowest address",
"ja": ""
},
{
