"en": "The Stack 3",
"ja": ""
},
{
"i": 49,
"where": "スライド8",
"en": "RSP points to the top of the stack - the lowest address which is being used",
"ja": ""
},
{
"i": 50,
"where": "スライド8",
"en": "While data will exist at addresses beyond the top of the stack, it is considered undefined",
"ja": ""
},
{
"i": 51,
"where": "スライド8",
"en": "Book page 107",
"ja": ""
},
{
"i": 52,
"where": "スライド9",
"en": "The Stack 4",
"ja": ""
},
{
"i": 53,
"where": "スライド9",
"en": "What can you find on the stack?",
"ja": ""
},
{
"i": 54,
"where": "スライド9",
"en": "\"Return addresses\" so a called function can return back to the function that called it",
"ja": ""
},
{
"i": 55,
"where": "スライド9",
"en": "Local variables",
"ja": ""
},
{
"i": 56,
"where": "スライド9",
"en": "Sometimes used to pass arguments between functions",
"ja": ""
},
{
"i": 57,
"where": "スライド9",
"en": "Save space for registers so functions can share registers without smashing the value for each other",
"ja": ""
},
{
"i": 58,
"where": "スライド9",
"en": "Save space for registers when the compiler has to juggle too many in a function",
"ja": ""
},
{
"i": 59,
"where": "スライド9",
"en": "Dynamically allocated memory via alloca()",
"ja": ""
},
